# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# --- Proyecto (Guía de gobernanza §2.A.3) ---
# Archivos crudos de edición / IA: viven en Drive, nunca en Git (solo los optimizados en /public)
raw-assets/
*.blend
*.blend1
*.mp4
*.mov
*.psd

# Generados por `postinstall` (scripts/copy-decoders.mjs)
/public/benchmarks/
